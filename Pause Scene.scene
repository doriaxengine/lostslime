              offset: 0
              count: 0
              normalized: true
              perInstance: false
        minBufferCount: 0
        minIndicesCount: 0
        primitiveType: triangles
        vertexCount: 0
        aabb:
          min: [0, 0, 0]
          max: [0, 0, 0]
        worldAABB:
          min: [0, 0, 0]
          max: [0, 0, 0]
        texture:
          textureType: 2D
          source: path
          path: ui/panel_grey.png
          minFilter: linear
          magFilter: linear
          wrapU: clamp_to_edge
          wrapV: clamp_to_edge
          releaseDataAfterLoad: true
        color: [1, 1, 1, 1]
        automaticFlipY: true
        flipY: false
        pointerMoved: false
        focused: false
