type: Entity
entity: 171
name: Door
components:
  transform:
    position: [0, 0, 0]
    rotation: [1, 0, 0, 0]
    scale: [1, 1, 1]
    visible: true
  mesh:
    submeshes:
      - material:
          baseColorFactor: [1, 1, 1, 1]
          metallicFactor: 1
          roughnessFactor: 1
          alphaCutoff: 0.5
          alphaMode: AUTO
          emissiveFactor: [0, 0, 0]
          baseColorTexture:
            textureType: "2D"
            source: path
            path: tiles/tileset.png
            minFilter: linear
            magFilter: linear
            wrapU: clamp_to_edge
            wrapV: clamp_to_edge
            releaseDataAfterLoad: true
          baseColorTexCoord: 0
          metallicRoughnessTexCoord: 0
          occlusionTexCoord: 0
          emissiveTexCoord: 0
          normalTexCoord: 0
          name: ""
        textureRect: [0.278015, 0.111206, 0.054748, 0.054748]
        primitiveType: triangles
        vertexCount: 0
        faceCulling: false
        textureShadow: true
        hasTexCoord1: true
        hasTexCoord2: false
        hasNormalMap: false
        hasTangent: true
        hasVertexColor3: false
        hasVertexColor4: true
        hasTextureRect: true
        hasSkinning: false
        hasMorphTarget: false
        hasMorphNormal: false
        hasMorphTangent: false
    normAdjustJoint: 1
    normAdjustWeight: 1
    morphWeights: [0, 0, 0, 0, 0, 0, 0, 0]
    aabb:
      min: [-32, 0, 0]
      max: [32, 64, 0]
    verticesAABB:
      min: [-32, 0, 0]
      max: [32, 64, 0]
    worldAABB:
      min: [-32, 0, 0]
      max: [32, 64, 0]
    receiveLights: false
    receiveIBL: false
    castShadows: false
    receiveShadows: false
    renderInReflectionProbes: true
    shadowsBillboard: false
    transparent: true
    cullingMode: back
    windingOrder: ccw
  sprite:
    width: 64
    height: 64
    automaticFlipY: true
    flipY: true
    textureScaleFactor: 0.5
    pivotPreset: bottom_center
    framesRect:
      - name: closed
        rect: [325, 130, 64, 64]
      - name: open
        rect: [455, 130, 64, 64]
  body2d:
    type: static
    numShapes: 1
    shapes:
      - type: polygon
        pointA: [-18, 4]
        pointB: [18, 120]
        radius: 0
        loop: false
        density: 1
        friction: 0.6
        restitution: 0
        sensor: true
        enableHitEvents: false
        contactEvents: false
        preSolveEvents: false
        sensorEvents: true
        categoryBits: 32
        maskBits: 65535
        groupIndex: 0
        vertices:
          - [-18, 4]
          - [18, 4]
          - [18, 120]
          - [-18, 120]
  script:
    scripts:
      - type: cpp
        path: scripts/ExitDoor.cpp
        headerPath: scripts/ExitDoor.h
        className: ExitDoor
        enabled: true
        properties:
          - name: needsKey
            displayName: Needs Key
            type: Bool
            value: true
            defaultValue: true
children:
