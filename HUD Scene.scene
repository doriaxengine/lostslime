id: 3
name: HUD Scene
scene:
  backgroundColor: [0.231, 0.298, 0.475, 1]
  shadowQuality: low
  meshLodEnabled: true
  meshLodThreshold: 1
  depthPrepassEnabled: false
  lightState: off
  globalIlluminationIntensity: 0.1
  globalIlluminationColor: [1, 1, 1]
  ambientLight2DIntensity: 1
  ambientLight2DColor: [1, 1, 1]
  shadow2DQuality: low
  ssaoEnabled: false
  ssaoRadius: 0.5
  ssaoIntensity: 1
  ssaoBias: 0.025
  ssrEnabled: false
  ssrMaxDistance: 8
  ssrThickness: 0.5
  ssrMaxSteps: 48
  ssrIntensity: 1
  ssrBlur: 0
  gravity2D: [0, -9.81]
  gravity3D: [0, -9.81, 0]
  fixedResolutionEnabled: false
  fixedResolutionWidth: 640
  fixedResolutionHeight: 360
  fixedResolutionFilter: nearest
  enableUIEvents: not_set
sceneType: scene_ui
mainCamera: 0
maxValues:
  maxSubmeshes: 0
  maxTilemapTilesRect: 0
  maxTilemapTiles: 0
  maxExternalBuffers: 0
  maxSpriteFrames: 0
  maxBones: 0
shaderKeys:
  - type: ui
    properties: 2
  - type: ui
    properties: 8
  - type: ui
    properties: 9
  - type: blit
cppScripts:
  - path: scripts/HudController.cpp
    headerPath: scripts/HudController.h
    className: HudController
    properties:
      - name: heart1
        isPtr: true
        ptrTypeName: doriax::Image
      - name: heart2
        isPtr: true
        ptrTypeName: doriax::Image
      - name: heart3
        isPtr: true
        ptrTypeName: doriax::Image
      - name: coinText
        isPtr: true
        ptrTypeName: doriax::Text
      - name: scoreText
        isPtr: true
        ptrTypeName: doriax::Text
      - name: keyIcon
        isPtr: true
        ptrTypeName: doriax::Image
      - name: levelText
        isPtr: true
        ptrTypeName: doriax::Text
      - name: fullHeart
        isPtr: false
      - name: emptyHeart
        isPtr: false
  - path: scripts/TouchControls.cpp
    headerPath: scripts/TouchControls.h
    className: TouchControls
    properties:
      - name: left
        isPtr: true
        ptrTypeName: doriax::Image
      - name: right
        isPtr: true
        ptrTypeName: doriax::Image
      - name: down
        isPtr: true
        ptrTypeName: doriax::Image
      - name: jump
        isPtr: true
        ptrTypeName: doriax::Image
      - name: pause
        isPtr: true
        ptrTypeName: doriax::Image
      - name: touchMargin
        isPtr: false
entities:
  - type: Entity
    entity: 1001
    name: HUD
    components:
      script:
        scripts:
          - type: cpp
            path: scripts/HudController.cpp
            headerPath: scripts/HudController.h
            className: HudController
            enabled: true
            properties:
              - name: heart1
                displayName: Heart 1
                type: EntityReference
                ptrTypeName: doriax::Image
                value: 1011
                defaultValue: 0
              - name: heart2
                displayName: Heart 2
                type: EntityReference
                ptrTypeName: doriax::Image
                value: 1012
                defaultValue: 0
              - name: heart3
                displayName: Heart 3
                type: EntityReference
                ptrTypeName: doriax::Image
                value: 1013
                defaultValue: 0
              - name: coinText
                displayName: Coin Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1021
                defaultValue: 0
              - name: scoreText
                displayName: Score Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1030
                defaultValue: 0
              - name: keyIcon
                displayName: Key Icon
                type: EntityReference
                ptrTypeName: doriax::Image
                value: 1014
                defaultValue: 0
              - name: levelText
                displayName: Level Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1031
                defaultValue: 0
              - name: fullHeart
                displayName: Full Heart Texture
                type: String
                value: ui/hud_heart.png
                defaultValue: ui/hud_heart.png
              - name: emptyHeart
                displayName: Empty Heart Texture
                type: String
                value: ui/hud_heart_empty.png
                defaultValue: ui/hud_heart_empty.png
