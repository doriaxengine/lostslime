id: 8
name: Level Three
scene:
  backgroundColor: [0.53, 0.81, 0.98, 1]
  shadowQuality: low
  meshLodEnabled: true
  meshLodThreshold: 1
  depthPrepassEnabled: false
  lightState: off
  globalIlluminationIntensity: 0.1
  globalIlluminationColor: [1, 1, 1]
  ambientLight2DIntensity: 1
  ambientLight2DColor: [1, 1, 1]
  shadow2DQuality: low
  ssaoEnabled: false
  ssaoRadius: 0.5
  ssaoIntensity: 1
  ssaoBias: 0.025
  ssrEnabled: false
  ssrMaxDistance: 8
  ssrThickness: 0.5
  ssrMaxSteps: 48
  ssrIntensity: 1
  ssrBlur: 0
  gravity2D: [0, -28]
  gravity3D: [0, -9.81, 0]
  fixedResolutionEnabled: false
  fixedResolutionWidth: 640
  fixedResolutionHeight: 360
  fixedResolutionFilter: nearest
  enableUIEvents: not_set
sceneType: scene_2d
mainCamera: 0
maxValues:
  maxSubmeshes: 1
  maxTilemapTilesRect: 44
  maxTilemapTiles: 408
  maxExternalBuffers: 0
  maxSpriteFrames: 7
  maxBones: 128
shaderKeys:
  - type: points
    properties: 5
  - type: mesh
    properties: 3075
  - type: depth
  - type: depth
    properties: 129
  - type: blit
childScenes:
  - id: 3
    startActive: true
  - id: 6
    startActive: false
cppScripts:
  - path: scripts/LevelController.cpp
    headerPath: scripts/LevelController.h
    className: LevelController
    properties:
      - name: sceneName
        isPtr: false
      - name: levelTitle
        isPtr: false
      - name: nextScene
        isPtr: false
      - name: levelWidth
        isPtr: false
      - name: levelHeight
        isPtr: false
      - name: cameraSmoothing
        isPtr: false
      - name: backgroundParallax
        isPtr: false
      - name: spawnPoint
        isPtr: true
        ptrTypeName: doriax::Object
  - path: scripts/ExitDoor.cpp
    headerPath: scripts/ExitDoor.h
    className: ExitDoor
    properties:
      - name: needsKey
        isPtr: false
  - path: scripts/Collectible.cpp
    headerPath: scripts/Collectible.h
    className: Collectible
    properties:
      - name: kind
        isPtr: false
      - name: scoreValue
        isPtr: false
      - name: bobHeight
        isPtr: false
      - name: bobSpeed
        isPtr: false
  - path: scripts/Enemy.cpp
    headerPath: scripts/Enemy.h
    className: Enemy
    properties:
      - name: speed
        isPtr: false
      - name: patrolDistance
        isPtr: false
      - name: flying
        isPtr: false
      - name: hoverHeight
        isPtr: false
      - name: hoverSpeed
        isPtr: false
      - name: canStomp
        isPtr: false
      - name: stompHeight
        isPtr: false
      - name: scoreValue
        isPtr: false
      - name: spriteFacesRight
        isPtr: false
  - path: scripts/PlayerController.cpp
    headerPath: scripts/PlayerController.h
    className: PlayerController
    properties:
      - name: moveSpeed
        isPtr: false
      - name: jumpSpeed
        isPtr: false
      - name: maxFallSpeed
        isPtr: false
      - name: coyoteTime
        isPtr: false
      - name: jumpBufferTime
        isPtr: false
      - name: hurtInvulnerability
        isPtr: false
      - name: stompBounce
        isPtr: false
      - name: walkFrameTime
        isPtr: false
      - name: colliderWidth
        isPtr: false
      - name: fallDeathY
        isPtr: false
bundles:
  - bundles/Bee.bundle
  - bundles/Coin.bundle
  - bundles/Door.bundle
  - bundles/Gem.bundle
  - bundles/Key.bundle
  - bundles/Player.bundle
  - bundles/Saw.bundle
  - bundles/Slime.bundle
  - bundles/Sounds.bundle
entities:
  - type: Entity
    entity: 1001
    name: Level
    components:
      script:
        scripts:
          - type: cpp
            path: scripts/LevelController.cpp
            headerPath: scripts/LevelController.h
            className: LevelController
            enabled: true
            properties:
              - name: sceneName
                displayName: Scene Name
                type: String
                value: Level Three
                defaultValue: Level One
              - name: levelTitle
                displayName: Level Title
                type: String
                value: Mushroom Peaks
                defaultValue: Green Hills
              - name: nextScene
                displayName: Next Scene
                type: String
                value: Win Scene
                defaultValue: Level Two
              - name: levelWidth
                displayName: Level Width
                type: Float
                value: 5120
                defaultValue: 3840
              - name: levelHeight
                displayName: Level Height
                type: Float
                value: 896
                defaultValue: 896
              - name: cameraSmoothing
                displayName: Camera Smoothing
                type: Float
                value: 8
                defaultValue: 8
              - name: backgroundParallax
                displayName: Background Parallax
                type: Float
                value: 0.3
                defaultValue: 0.3
              - name: spawnPoint
                displayName: Spawn Point
                type: EntityReference
                ptrTypeName: doriax::Object
                value: 1002
                defaultValue: 0
  - type: Entity
    entity: 1003
    name: Sounds
    components:
      bundle:
        name: Sounds
        path: bundles/Sounds.bundle
